# =============================================================================
# CrowdShield — Environment Variables
# Copy this file to `.env` and fill in your real values. Never commit `.env`.
# =============================================================================

# --- Supabase (database + auth + storage) ---
# Project URL and keys from your Supabase project dashboard (Settings > API).
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# --- Generative AI providers ---
# Gemini API key (primary LLM) from Google AI Studio.
GEMINI_API_KEY=
# Optional Anthropic Claude API key (supplementary LLM) from the Anthropic Console.
ANTHROPIC_API_KEY=

# --- Weather integration ---
# OpenWeatherMap free-tier API key.
OPENWEATHERMAP_API_KEY=

# --- Firebase (mobile push notifications, FCM) ---
# JSON blob of the Firebase service-account / config (stringified).
FIREBASE_CONFIG_JSON=

# --- Backend URLs ---
# WebSocket endpoint for real-time live data stream.
BACKEND_WS_URL=ws://localhost:8000/ws/live
# HTTP/REST base URL for the FastAPI backend.
BACKEND_HTTP_URL=http://localhost:8000
