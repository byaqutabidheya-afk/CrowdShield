# =============================================================================
# CrowdShield — ai_core/genai_pipeline — Environment Variables
# Copy this file to `.env` and fill in your real values. Never commit `.env`.
#
# NOTE: This pipeline uses Google Gemini as its ONLY LLM provider.
#       No Anthropic / Claude key is required or used.
# =============================================================================

# --- Google Gemini (REQUIRED) ---
# Obtain your API key from Groq: https://console.groq.com/keys
# This key is used exclusively by LLMClient (llm_client.py) and all downstream
# scripts in the genai_pipeline.  The pipeline will refuse to start without it.
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-20b

# =============================================================================
# The variables below are shared with the wider CrowdShield project.
# If you are running genai_pipeline in isolation you may leave them blank;
# if you are running the full stack, populate them here or in the root .env.
# =============================================================================

# --- Supabase (database + auth + storage) ---
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# --- Weather integration ---
OPENWEATHERMAP_API_KEY=

# --- Backend URLs ---
BACKEND_WS_URL=ws://localhost:8000/ws/live
BACKEND_HTTP_URL=http://localhost:8000
