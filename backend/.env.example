# =============================================================================
# CrowdShield Backend — Environment Variables
# Inherits root `.env.example` plus backend-specific settings.
# =============================================================================

# --- Backend Server Configuration ---
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# --- Venue Coordinates for Weather Integration (Set to actual demo venue coordinates) ---
VENUE_LAT=20.34472597223267
VENUE_LON=85.80678043814832
WEATHER_POLL_INTERVAL_SECONDS=600

# --- Supabase (database + auth + storage) ---
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# --- Generative AI (Gemini) ---
GEMINI_API_KEY=
ANTHROPIC_API_KEY=

# --- Weather integration ---
OPENWEATHERMAP_API_KEY=

# --- Firebase (mobile push notifications, FCM) ---
FIREBASE_CONFIG_JSON=
FIREBASE_SERVICE_ACCOUNT_PATH=config/firebase_service_account.json

# --- Backend URLs ---
BACKEND_WS_URL=ws://localhost:8000/ws/live
BACKEND_HTTP_URL=http://localhost:8000
